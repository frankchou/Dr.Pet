# ═══════════════════════════════════════════════════════════════
# PurePaw 環境變數範本
# ═══════════════════════════════════════════════════════════════
# 本專案採「一份程式碼、兩套環境設定」：
#
#   dev  （本機 / Codespace / Vercel Preview）→ 連 dev.db 或 preview Turso
#   prod （Vercel Production）                → 連正式 Turso
#
# 值的來源：
#   dev  → 本檔複製成 .env（.env 已被 .gitignore 排除，不會進 git）
#          機密值建議改放 GitHub → repo Settings → Secrets → Codespaces，
#          開 Codespace 時自動注入，且「環境變數優先於 .env」，不必手動填。
#          由 Secrets 提供的項目，.devcontainer/setup.sh 不會在 .env 再寫一份明文；
#          手動維護 .env 時建議比照，並保持檔案權限 600。
#   prod → Vercel → Settings → Environment Variables（.env 檔永遠到不了 Vercel）
#
# 程式如何分辨自己在哪：src/lib/env.ts 的 getAppEnv()
#   VERCEL_ENV=production → 'production'
#   VERCEL_ENV=preview    → 'preview'
#   其餘（本機）          → 'development'
# ═══════════════════════════════════════════════════════════════

# ── 資料庫 ──────────────────────────────────────────────────────
# dev  : 一律 file:./dev.db。本機連 libsql:// 會被防呆中止（四道守衛：src/lib/prisma.ts、
#        prisma.config.ts、prisma/seed.ts、scripts/*-turso.mjs）。
# prod : libsql://xxxx.turso.io（只填在 Vercel，絕不寫進任何 .env 檔）
DATABASE_URL="file:./dev.db"
# dev 不需要；prod / preview 才需要 Turso token
DATABASE_AUTH_TOKEN=""

# ── NextAuth ────────────────────────────────────────────────────
# 沒設 AUTH_SECRET 的話 production 會直接拋 MissingSecret，全站登入失效。
# 產生方式：openssl rand -base64 32
AUTH_SECRET=""
# dev  : http://localhost:3000
# prod : https://<你的正式網域>   ← 邀請信連結會用，填錯對方點不開
NEXTAUTH_URL="http://localhost:3000"

# ── Google 登入（Google Cloud Console → API 和服務 → 憑證）──────
# 重新導向 URI 要同時加 http://localhost:3000/api/auth/callback/google
# 與 https://<正式網域>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Anthropic（console.anthropic.com → API Keys）────────────────
# 建議 dev / prod 各開一把，方便分開計費與單獨停用
ANTHROPIC_API_KEY=""

# ── 寄信：Gmail SMTP（邀請信 / 問題回報 / 評論通知）─────────────
# GMAIL_APP_PASSWORD 為 16 碼應用程式密碼（需先開兩步驟驗證）
GMAIL_USER="purepaw.notify@gmail.com"
GMAIL_APP_PASSWORD=""

# ── Web Push VAPID ──────────────────────────────────────────────
# 產生方式：node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY 的值與 VAPID_PUBLIC_KEY 相同（前端也要讀得到）
# ⚠️ 上線後不可更換，換掉會讓所有既有推播訂閱失效
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:purepaw.notify@gmail.com"

# ── 排程授權（Vercel Cron）──────────────────────────────────────
# 設了之後 Vercel Cron 會自動帶 Authorization: Bearer <CRON_SECRET>
# 產生方式：openssl rand -hex 32
CRON_SECRET=""

# ── Demo 登入口 ─────────────────────────────────────────────────
# dev  : true（測試帳號 demo@drpet.com / demo1234）
# prod : 【絕對不要設】設了正式站就會出現 demo 登入入口
DEMO_ENABLED="true"
NEXT_PUBLIC_DEMO_ENABLED="true"

# ── 逃生門（平常不要設）─────────────────────────────────────────
# 設為 "true" 可解除「本機禁止連遠端資料庫」的防呆。
# 只有在明確要對正式庫做維護時才臨時開啟，用完立刻移除。
# ALLOW_REMOTE_DB="true"
