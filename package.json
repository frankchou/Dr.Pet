{
  "name": "dr-pet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "bash .devcontainer/setup.sh",
    "db:migrate": "DATABASE_URL=\"file:./dev.db\" prisma migrate deploy",
    "db:seed": "DATABASE_URL=\"file:./dev.db\" prisma db seed",
    "db:reset": "rm -f dev.db dev.db-journal dev.db-wal dev.db-shm && npm run db:migrate && npm run db:seed",
    "db:studio": "DATABASE_URL=\"file:./dev.db\" prisma studio",
    "db:audit-prod": "node scripts/check-turso-migrations.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@vercel/blob": "^2.8.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "jiti prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
