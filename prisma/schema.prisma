// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nickname      String?   @unique
  createdAt     DateTime  @default(now())

  accounts          Account[]
  petMemberships    PetMember[]
  sentInvitations   PetInvitation[] @relation("InvitedBy")
  pushSubscriptions PushSubscription[]

  // 原有 relation
  pets          Pet[]
}

// Web Push 訂閱（一個使用者可在多個裝置/瀏覽器訂閱，1 User : N Subscription）。
// 推播偏好開關放訂閱層級：不同裝置可有不同行為，退訂只需刪該 endpoint。
model PushSubscription {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint         String   @unique // 瀏覽器 push service 的唯一端點，天然去重鍵（upsert by endpoint）
  p256dh           String            // 客戶端公鑰（加密用）
  auth             String            // 客戶端 auth secret
  foodAlertEnabled Boolean  @default(true) // 食安警報推播開關
  reminderEnabled  Boolean  @default(true) // 用藥/美容提醒推播開關
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PetMember {
  id       String   @id @default(cuid())
  petId    String
  pet      Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   // "owner" | "co_owner"
  joinedAt DateTime @default(now())

  @@unique([petId, userId])
}

model PetInvitation {
  id          String    @id @default(cuid())
  petId       String
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  targetEmail String    // 限定受邀 email
  token       String    @unique @default(cuid())
  status      String    @default("pending")  // "pending" | "accepted" | "expired"
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?
  createdAt   DateTime  @default(now())
}

model Pet {
  id             String         @id @default(cuid())
  name           String
  species        String
  breed          String?
  sex            String
  birthday       DateTime?
  weight         Float?
  isNeutered     Boolean        @default(false)
  allergies      String?
  medicalHistory String?
  mainProblems   String         @default("[]")
  avatar         String?
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members        PetMember[]
  invitations    PetInvitation[]

  symptoms       SymptomEntry[]
  productUsages  ProductUsage[]
  documents      Document[]
  insights       AIInsight[]
  chatMessages   ChatMessage[]
  weeklyTasks          WeeklyTask[]
  nutritionAnalyses    NutritionAnalysis[]
  productRecommendationResults ProductRecommendationResult[]
  instantAnalyses      InstantAnalysis[]
  petProducts          PetProduct[]
  productReactions     ProductReaction[]
  communityRecs        CommunityRec[]
  healthMetrics        HealthMetric[]
  dailyHealthLogs      DailyHealthLog[]
  medicationRecords    MedicationRecord[]
  groomingRecords      GroomingRecord[]
  measurementRecords   MeasurementRecord[]
  dailyMealPlans       DailyMealPlan[]
}

model SymptomEntry {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  symptomType String
  severity    Int
  side        String?
  notes       String?
  photos      String   @default("[]")
  createdAt   DateTime @default(now())
}

model Product {
  id             String         @id @default(cuid())
  type           String
  name           String
  brand          String?
  variant        String?
  ingredientText String?
  ingredientJson String?
  photos         String         @default("[]")
  createdAt      DateTime       @default(now())
  usages         ProductUsage[]
  petProducts    PetProduct[]
  reactions      ProductReaction[]
  communityRecsFor   CommunityRec[] @relation("BadProduct")
  communityRecsRec   CommunityRec[] @relation("RecommendedProduct")
  mealPlanItems      MealPlanItem[]
}

model ProductUsage {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  date        DateTime @default(now())
  frequency   String?
  amountLevel String?
  notes       String?
  createdAt   DateTime @default(now())
}

// Pet's managed product list (固定清單 / 試用清單)
model PetProduct {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  listType    String   // "fixed" | "trial"
  trialReason String?  // only for listType="trial"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Daily reaction record per product
model ProductReaction {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  date        String   // "YYYY-MM-DD"
  rating      String   // "good" | "ok" | "bad"
  notes       String?
  sharedAt    DateTime? // non-null = shared to community pool
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([petId, productId, date])
}

// Community recommendation cards shown to users
model CommunityRec {
  id                   String   @id @default(cuid())
  forPetId             String
  forPet               Pet      @relation(fields: [forPetId], references: [id], onDelete: Cascade)
  badProductId         String
  badProduct           Product  @relation("BadProduct", fields: [badProductId], references: [id])
  recommendedProductId String
  recommendedProduct   Product  @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])
  symptomTypes         String   @default("[]") // JSON array of symptom types
  basedOnCount         Int      @default(0)    // number of similar-pet good reactions
  fromAI               Boolean  @default(false)
  aiRationale          String?
  dismissed            Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model Document {
  id                  String   @id @default(cuid())
  petId               String
  pet                 Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  type                String
  photos              String   @default("[]")
  extractedText       String?
  extractedStructured String?
  createdAt           DateTime @default(now())
}

model AIInsight {
  id                 String   @id @default(cuid())
  petId              String
  pet                Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  symptomType        String?
  suspectedTriggers  String   @default("[]")
  helpfulFactors     String   @default("[]")
  confidence         String   @default("low")
  rationale          String?
  recommendedActions String   @default("[]")
  createdAt          DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model WeeklyTask {
  id          String    @id @default(cuid())
  petId       String
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model NutritionAnalysis {
  id           String   @id @default(cuid())
  petId        String
  pet          Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  resultJson   String
  productCount Int
  createdAt    DateTime @default(now())
}

model ProductRecommendationResult {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  resultJson String   // JSON array of ProductRec[]
  createdAt  DateTime @default(now())
}

model InstantAnalysis {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  verdict     String   // 'safe' | 'caution' | 'danger'
  summary     String
  resultJson  String   // full JSON with concerns, positives, ingredients
  imagePath   String?  // saved image path in /public/uploads/
  createdAt   DateTime @default(now())
}

model HealthMetric {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  bodyScore   Int?     // 1-9 BCS 體態評分
  vitality    String?  // "low" | "medium" | "high" 活力指數
  waterIntake String?  // "low" | "medium" | "high" 水分攝取
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([petId, date])
}

// 每日健康日誌主體
model DailyHealthLog {
  id              String   @id @default(cuid())
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  appetite        String?  // 胃口極佳/食慾正常/猶豫慢食/挑食偏食/完全拒食
  waterMl         Int?     // 飲水毫升
  waterStatus     String?  // 飲水正常/異常狂喝/幾乎沒喝
  stoolType       String?  // 羊便便/正常成形/便便偏軟/泥水腹瀉
  stoolDetails    String   @default("[]") // JSON array：帶血/帶黏液/顏色異常/排便費力/氣味極臭
  urineStatus     String?  // 尿量正常/頻尿蹲/極稀少/血尿
  vitality        String?  // 精神飽滿/活動意願高/異常疲倦
  mood            String   @default("[]") // JSON array：平靜放鬆/焦躁不安/攻擊低吼/異常嚎叫
  skinHair        String   @default("[]") // JSON array 多選
  skinHairPhotos  String   @default("[]") // JSON array 圖片 URL
  eyeEar          String   @default("[]") // JSON array
  eyeEarPhotos    String   @default("[]")
  dental          String   @default("[]") // JSON array
  dentalPhotos    String   @default("[]")
  digestion       String   @default("[]") // JSON array
  digestionPhotos String   @default("[]")
  respiratory     String   @default("[]") // JSON array
  neuro           String   @default("[]") // JSON array
  reproductive    String   @default("[]") // JSON array（依性別存不同選項）
  dailyChecklist  String   @default("[]") // JSON array：已完成的例行項目
  dietStatusTab   String?  // 今日飲食狀態 tab：all/reduced/forbidden
  mealStatuses    String   @default("{}") // JSON：{ morning: 'done'|'refused'|'outside', noon: ..., evening: ... }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([petId, date])
}

// 用藥與看診記錄
model MedicationRecord {
  id            String    @id @default(cuid())
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  date          String    // YYYY-MM-DD
  vaccines      String    @default("[]") // JSON array
  deworming     String    @default("[]") // JSON array
  prescriptions String    @default("[]") // JSON array
  clinicVisits  String    @default("[]") // JSON array
  photoUrl      String?   // 藥袋/收據照片
  nextReminder  DateTime?
  // 提醒週期：null = 一次性（推完清 nextReminder）、>0 = 每 N 天循環（推完 nextReminder += N）
  reminderIntervalDays Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 洗澡美容記錄
model GroomingRecord {
  id                String    @id @default(cuid())
  petId             String
  pet               Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  date              String    // YYYY-MM-DD
  mode              String    // home/basic/full
  medBath           Boolean   @default(false)
  medBathProduct    String?
  carbonatedSpa     Boolean   @default(false)
  carbonatedProduct String?
  dentalClean       Boolean   @default(false)
  dentalProduct     String?
  customTreatment   Boolean   @default(false)
  customName        String?
  photoUrl          String?
  nextReminder      DateTime?
  // 提醒週期：null = 一次性（推完清 nextReminder）、>0 = 每 N 天循環（推完 nextReminder += N）
  reminderIntervalDays Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 量測與追蹤記錄
model MeasurementRecord {
  id                 String    @id @default(cuid())
  petId              String
  pet                Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  date               String    // YYYY-MM-DD
  weightKg           Float?
  bodyCondition      String?   // lean/normal/overweight
  rrr                Int?      // 靜止呼吸率（次/分）
  bloodSugarTiming   String?   // fasting/postMeal2h/postInsulin
  bloodSugarMgdl     Float?
  bloodPressureSys   Int?      // 收縮壓
  bloodPressureDia   Int?      // 舒張壓
  tempMethod         String?   // rectal/ear/axillary
  tempCelsius        Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 每日餐食計畫主體
model DailyMealPlan {
  id        String         @id @default(cuid())
  petId     String
  pet       Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  date      String         // YYYY-MM-DD
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     MealPlanItem[]

  @@unique([petId, date])
}

// 餐食計畫項目（早/午/晚）
model MealPlanItem {
  id             String        @id @default(cuid())
  planId         String
  plan           DailyMealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  session        String        // morning/noon/evening
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  customName     String?
  quantity       Float         @default(1)
  unit           String        @default("份")
  estimatedGrams Float?
  tags           String        @default("[]") // JSON array
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
}

// AI 生成的寵物健康快訊
model NewsArticle {
  id          String    @id @default(cuid())
  category    String    // food_safety / danger / health
  subCategory String?
  title       String
  summary     String
  sourceUrl   String?
  sourceName  String?
  publishedAt DateTime?
  isUrgent    Boolean   @default(false)
  // 食安警報涉及的廠商/品牌/產品關鍵詞（JSON string array），供個人化頭條比對 PetProduct 用
  affectedBrands    String?
  // 已觸發食安推播的時間戳；非 null 代表此文章已推過，防止重複推播（同文章只推一次）
  foodAlertPushedAt DateTime?
  createdAt   DateTime  @default(now())
}
